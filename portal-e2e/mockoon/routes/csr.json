{
  "description": "CSR 門號交易與退款查詢後端情境",
  "routes": [
    {
      "method": "GET",
      "path": "csr/trans",
      "documentation": "SRS 4.8 依門號查交易及退款",
      "responses": [
        { "label": "兩筆交易與一筆退款（預設）", "default": true, "status": 200, "contentType": "text/html;charset=UTF-8", "bodyFile": "csr-default.html", "example": { "query": { "msisdn": "0912345678" } } },
        { "label": "查無交易及退款", "rules": [{ "target": "query", "key": "msisdn", "operator": "equals", "value": "0900000000" }], "status": 200, "contentType": "text/html;charset=UTF-8", "bodyFile": "csr-empty.html", "example": { "query": { "msisdn": "0900000000" } } },
        { "label": "後端 500", "rules": [{ "target": "query", "key": "msisdn", "operator": "equals", "value": "0950000000" }], "status": 500, "contentType": "text/plain;charset=UTF-8", "bodyFile": "backend-500.txt", "example": { "query": { "msisdn": "0950000000" } } },
        { "label": "11 筆交易且最多回傳 10 列", "rules": [{ "target": "query", "key": "msisdn", "operator": "equals", "value": "0910000010" }], "status": 200, "contentType": "text/html;charset=UTF-8", "bodyFile": "csr-eleven-capped.html", "example": { "query": { "msisdn": "0910000010" } } },
        { "label": "格式不符仍查無資料", "rules": [{ "target": "query", "key": "msisdn", "operator": "equals", "value": "BADNUMBER" }, { "target": "query", "key": "msisdn", "operator": "equals", "value": "090000000" }], "status": 200, "contentType": "text/html;charset=UTF-8", "bodyFile": "csr-empty.html", "example": { "query": { "msisdn": "BADNUMBER" } } },
        { "label": "空門號仍查無資料", "rules": [{ "target": "query", "key": "msisdn", "operator": "equals", "value": "" }], "status": 200, "contentType": "text/html;charset=UTF-8", "bodyFile": "csr-empty.html", "example": { "query": { "msisdn": "" } } },
        { "label": "查詢 SQL 錯誤", "rules": [{ "target": "query", "key": "msisdn", "operator": "equals", "value": "0900000001" }], "status": 200, "contentType": "text/html;charset=UTF-8", "bodyFile": "csr-query-error.html", "example": { "query": { "msisdn": "0900000001" } } }
      ]
    }
  ]
}