{
  "description": "服務條款設定（SRS 4.6）。目前只為 US-COM-01 提供登入後查詢與存檔成功的預設回應。",
  "routes": [
    {
      "method": "GET",
      "path": "sa/tos/query",
      "documentation": "SRS 4.6 查詢商家服務條款（JSON 陣列，版次降冪）",
      "responses": [
        { "label": "已有 v2、v1 兩版次（預設）", "default": true, "status": 200, "contentType": "application/json", "bodyFile": "tos-e000001.json" }
      ]
    },
    {
      "method": "POST",
      "path": "sa/tos/save",
      "documentation": "SRS 4.6 存檔服務條款（Mockoon 無狀態：存檔回 version=3，重查仍回 v2）",
      "responses": [
        { "label": "存檔成功 version=3（預設）", "default": true, "status": 200, "contentType": "text/plain;charset=UTF-8", "body": "OK version=3 url=http://localhost:8099/getToS.jsp?merchantID=E000001&version=3" }
      ]
    }
  ]
}
