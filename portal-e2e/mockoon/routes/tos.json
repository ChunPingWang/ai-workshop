{
  "description": "服務條款查詢與建立新版次後端情境",
  "routes": [
    {
      "method": "GET",
      "path": "sa/tos/query",
      "documentation": "SRS 4.6 查詢商家服務條款",
      "responses": [
        { "label": "兩個版本（預設）", "default": true, "status": 200, "contentType": "application/json", "bodyFile": "tos-default.json", "example": { "query": { "merchantID": "E000001" } } },
        { "label": "只有一個版本且內容換行", "rules": [{ "target": "query", "key": "merchantID", "operator": "equals", "value": "E000003" }], "status": 200, "contentType": "application/json", "bodyFile": "tos-single.json", "example": { "query": { "merchantID": "E000003" } } },
        { "label": "商家尚無條款", "rules": [{ "target": "query", "key": "merchantID", "operator": "equals", "value": "E000002" }], "status": 200, "contentType": "application/json", "bodyFile": "empty.json", "example": { "query": { "merchantID": "E000002" } } },
        { "label": "後端 500", "rules": [{ "target": "query", "key": "merchantID", "operator": "equals", "value": "E500000" }], "status": 500, "contentType": "text/plain;charset=UTF-8", "bodyFile": "backend-500.txt", "example": { "query": { "merchantID": "E500000" } } },
        { "label": "非 JSON 回應", "rules": [{ "target": "query", "key": "merchantID", "operator": "equals", "value": "E999JSON" }], "status": 200, "contentType": "text/plain;charset=UTF-8", "bodyFile": "non-json.txt", "example": { "query": { "merchantID": "E999JSON" } } }
      ]
    },
    {
      "method": "GET",
      "path": "getToS.jsp",
      "documentation": "SRS 4.6 對外讀取已發布服務條款，不經 Portal",
      "responses": [
        { "label": "最新條款（預設）", "default": true, "status": 200, "contentType": "text/html;charset=UTF-8", "bodyFile": "tos-public.html", "example": { "query": { "merchantID": "E000001", "version": "2" } } },
        { "label": "指定第一版", "rules": [{ "target": "query", "key": "version", "operator": "equals", "value": "1" }], "status": 200, "contentType": "text/html;charset=UTF-8", "bodyFile": "tos-public-v1.html", "example": { "query": { "merchantID": "E000001", "version": "1" } } },
        { "label": "查無條款", "rules": [{ "target": "query", "key": "merchantID", "operator": "equals", "value": "E000002" }], "status": 200, "contentType": "text/html;charset=UTF-8", "bodyFile": "tos-public-empty.html", "example": { "query": { "merchantID": "E000002" } } },
        { "label": "未指定商家時顯示全域預設條款", "rules": [{ "target": "query", "key": "merchantID", "operator": "null" }], "status": 200, "contentType": "text/html;charset=UTF-8", "bodyFile": "tos-public-global.html", "example": { "query": {} } }
      ]
    },
    {
      "method": "POST",
      "path": "sa/tos/save",
      "documentation": "SRS 4.6 建立服務條款新版次",
      "responses": [
        { "label": "建立新版次成功（預設）", "default": true, "status": 200, "contentType": "text/plain;charset=UTF-8", "bodyFile": "tos-save-v3.txt", "example": { "form": { "merchantID": "E000001", "startDate": "20260916090000", "content": "新條款 v3", "note": "BDD" } } },
        { "label": "新商家第一版成功", "rules": [{ "target": "body", "key": "merchantID", "operator": "equals", "value": "E000002" }], "status": 200, "contentType": "text/plain;charset=UTF-8", "bodyFile": "tos-save-v1.txt", "example": { "form": { "merchantID": "E000002", "startDate": "20260916090000", "content": "第一版條款" } } },
        { "label": "條款內容觸發存檔失敗", "rules": [{ "target": "body", "key": "content", "operator": "regex", "value": ".*FAIL.*" }], "status": 200, "contentType": "text/plain;charset=UTF-8", "bodyFile": "save-fail-length.txt", "example": { "form": { "merchantID": "E000001", "startDate": "20260916090000", "content": "FAIL" } } },
        { "label": "條款內容含單引號造成 SQL 錯誤", "rules": [{ "target": "body", "key": "content", "operator": "regex", "value": ".*'.*" }], "status": 200, "contentType": "text/plain;charset=UTF-8", "bodyFile": "save-fail-sql.txt", "example": { "form": { "merchantID": "E000001", "startDate": "20260916090000", "content": "條款內容'" } } },
        { "label": "必要欄位空白", "rules": [{ "target": "body", "key": "content", "operator": "equals", "value": "" }], "status": 200, "contentType": "text/plain;charset=UTF-8", "bodyFile": "save-fail-null.txt", "example": { "form": { "merchantID": "E000001", "startDate": "20260916090000", "content": "" } } },
        { "label": "商家代碼超過欄位長度", "rules": [{ "target": "body", "key": "merchantID", "operator": "equals", "value": "E00000000000" }], "status": 200, "contentType": "text/plain;charset=UTF-8", "bodyFile": "save-fail-length.txt", "example": { "form": { "merchantID": "E00000000000", "startDate": "20260916090000", "content": "條款" } } },
        { "label": "生效日期超過欄位長度", "rules": [{ "target": "body", "key": "startDate", "operator": "equals", "value": "202609160900001" }], "status": 200, "contentType": "text/plain;charset=UTF-8", "bodyFile": "save-fail-length.txt", "example": { "form": { "merchantID": "E000001", "startDate": "202609160900001", "content": "條款" } } }
      ]
    }
  ]
}