      ]
    },
    {
      "method": "GET",
      "path": "sa/report/reconDailyDetail",
      "documentation": "SRS 4.5 每日對帳差異明細",
      "responses": [
        { "label": "差異 1 筆 104（預設）", "default": true, "status": 200, "contentType": "text/html;charset=UTF-8", "bodyFile": "recon-detail-diff.html" }
      ]
    }
  ]
}
