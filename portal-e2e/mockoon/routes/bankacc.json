{
  "description": "商家銀行帳戶註冊（SRS 4.7）。目前只為 US-COM-01 提供登入後查詢與註冊成功的預設回應。",
  "routes": [
    {
      "method": "GET",
      "path": "cp/bankacc/list",
      "documentation": "SRS 4.7 查詢已註冊帳戶（JSON 陣列）",
      "responses": [
        { "label": "已註冊 2 個帳戶（預設）", "default": true, "status": 200, "contentType": "application/json", "bodyFile": "bankacc-e000001.json" }
      ]
    },
    {
      "method": "POST",
      "path": "cp/bankacc/save",
      "documentation": "SRS 4.7 註冊銀行帳戶",
      "responses": [
        { "label": "註冊成功（預設）", "default": true, "status": 200, "contentType": "text/plain;charset=UTF-8", "body": "OK" }
      ]
    }
  ]
}
